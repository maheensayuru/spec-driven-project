{
  "name": "renewalradar",
  "version": "0.1.0",
  "private": true,
  "description": "RenewalRadar - Continuous B2B Contract & Obligation Monitoring Platform",
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "demo:reset": "npm run demo:reset --workspace=backend",
    "demo:seed": "npm run db:seed --workspace=backend"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  }
}
