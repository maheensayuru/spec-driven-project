# Node & Server
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
SESSION_SECRET=renewalradar_super_secure_session_secret_32_bytes_min

# Development database: Docker PostgreSQL 16 uses host port 5433.
# auto falls back to durable PGlite only when PostgreSQL is unreachable.
# Use postgres for strict PostgreSQL verification; pglite explicitly selects embedded storage.
DATABASE_MODE=auto
DATABASE_URL=postgresql://renewalradar:local_dev_password@localhost:5433/renewalradar_dev
# Optional absolute path; defaults to backend/.data/postgres regardless of working directory.
# PGLITE_DATA_DIR=C:/tmp/spec-driven-project/backend/.data/postgres

# Cache & Distributed Queue (Redis)
REDIS_URL=redis://localhost:6379

# Object Storage (S3 / MinIO)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=renewalradar-documents
S3_ACCESS_KEY_ID=minio_admin
S3_SECRET_ACCESS_KEY=minio_dev_password
S3_FORCE_PATH_STYLE=true

# AI Document Extraction
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Frontend browser API endpoint (set in frontend/.env.local when overriding).
# This is public configuration, never put database credentials in NEXT_PUBLIC_* values.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Notifications & Email
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="RenewalRadar Alerts <alerts@renewalradar.local>"
