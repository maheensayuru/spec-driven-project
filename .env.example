# Node & Server
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
SESSION_SECRET=renewalradar_super_secure_session_secret_32_bytes_min

# Database (PostgreSQL)
DATABASE_URL=postgresql://renewalradar:local_dev_password@localhost:5432/renewalradar_dev

# Cache & Distributed Queue (Redis)
REDIS_URL=redis://localhost:6379

# Object Storage (S3 / MinIO)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=renewalradar-documents
S3_ACCESS_KEY_ID=minio_admin
S3_SECRET_ACCESS_KEY=minio_dev_password
S3_FORCE_PATH_STYLE=true

# AI Document Extraction
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Notifications & Email
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="RenewalRadar Alerts <alerts@renewalradar.local>"
